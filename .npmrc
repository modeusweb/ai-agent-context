# ai-agent-context
# npm registry and publish settings
# Note: npm auth token is stored globally (user-level .npmrc) or via CI secrets.
# Do not commit a token here. If you need a project-local token for CI, use an
# environment variable or a secret manager and inject it at publish time.

registry=https://registry.npmjs.org/

# Ensure public access for scoped packages in this monorepo.
# Each package already declares publishConfig.access = "public", but this
# global setting removes any ambiguity during `npm publish`.
access=public

# Keep node_modules out of published packages (defensive; each package also
# uses the "files" field in package.json to whitelist what gets published).
ignore-scripts=false
