{
  "name": "ai-agent-context",
  "version": "0.3.0",
  "description": "Git-native context layer for AI coding agents: scan a repository into a structured, versionable .agent/ knowledge layer and query it (CLI + programmatic API).",
  "type": "module",
  "license": "MIT",
  "author": "modeusweb <modeusweb@gmail.com>",
  "homepage": "https://github.com/modeusweb/ai-agent-context",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modeusweb/ai-agent-context.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/modeusweb/ai-agent-context/issues"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "keywords": [
    "ai-agent",
    "coding-agent",
    "context",
    "cli",
    "architecture",
    "repository-analysis",
    "knowledge-graph",
    "git",
    "llm-context",
    "code-analysis"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "agent-context": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "prepublishOnly": "cd ../.. && npm run verify"
  },
  "dependencies": {
    "@ai-agent-context/core": "^0.3.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
